# Configuration commune aux quatre JAR. Format Java Properties, sans guillemets.

# authorization-server (et parametres partages lors de leur premiere occurrence)
OAUTH_PORT=8081
OAUTH2_DESKTOP_CLIENTID=espaceAdh
OAUTH2_DESKTOP_CLIENTSECRET=
OAUTH2_DESKTOP_ACCESSTOKEN_VALIDITY=3600
OAUTH2_DESKTOP_REFRESHTOKEN_VALIDITY=36000
AUTHORIZATION_SERVER_OAUTH2_RESS_ADH_CLIENTID=ress-adherents
AUTHORIZATION_SERVER_OAUTH2_RESS_ADH_CLIENTSECRET=
OAUTH2_RESS_ADH_ACCESSTOKEN_VALIDITY=3600
OAUTH2_RESS_ADH_REFRESHTOKEN_VALIDITY=36000
# Chemin absolu ou relatif au dossier du .env
JKS_KEYSTORE=mytest.jks
JKS_KEYPASS=
JKS_ALIAS=mytest
JDBC_URL=jdbc:postgresql://localhost:5432/authorization
JDBC_USER=authentification_user
JDBC_PASS=
OAUTH2_ISSUER=http://localhost:8081/authorization-server

# resource-adherents (et parametres partages lors de leur premiere occurrence)
ADHERENTS_PORT=8082
LOGGING_LEVEL_ORG=INFO
ADHERENTS_SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/jalleastro
ADHERENTS_SPRING_DATASOURCE_USERNAME=postgres
ADHERENTS_SPRING_DATASOURCE_PASSWORD=
# Cle publique commune : chemin absolu ou relatif au dossier du .env
KEY_PUBLIC=public.txt
MAILJET_LOGIN=
MAILJET_PASSWORD=
MESSAGE_FROM_MAIL=
MESSAGE_FROM_NAME=
MESSAGE_TO_MAIL=
MESSAGE_TO_NAME=
ADHERENTS_MESSAGE_TEMPLATE_CODE_PREINSCRIPTION=
MESSAGE_PREINSCRIPTION_ID=123456
ADHERENTS_VALIDATIONMAIL_URL=http://jalle-astro/
ADHERENTS_OAUTH2_RESS_ADH_CLIENTID=ress-adherents
ADHERENTS_OAUTH2_RESS_ADH_CLIENTSECRET=
ADHERENTS_OAUTH2_URL=https://api.jalle-astro.fr/authorization-server/oauth/token
API_RESS_AUTHORIZATION_URL=https://api.jalle-astro.fr/resource-authorization/authentification/$/roles
API_RESS_AUTHORIZATION_PUT_URL=https://api.jalle-astro.fr/resource-authorization/authentification/
API_RESS_AUTHORIZATION_ACTIVATION_URL=https://api.jalle-astro.fr/resource-authorization/authentification/$/activation
FOLDER_PATH_PHOTO_PROFIL=/bebebe/bebebe
MESSAGE_DEV=false

