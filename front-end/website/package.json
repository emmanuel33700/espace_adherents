{
  "name": "espace-adherents",
  "version": "5.0.1",
  "license": "GPL",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emmanuel33700/espace_adherents.git"
  },
  "bugs": {
    "url": "https://github.com/emmanuel33700/espace_adherents/issues"
  },
  "scripts": {
    "ng": "ng",
    "conventional-changelog": "conventional-changelog",
    "start": "ng serve",
    "start:preprod": "ng serve --configuration preprod",
    "build": "ng build",
    "build:prod": "npm run build -- --configuration production --aot",
    "test": "ng test",
    "test:coverage": "rimraf coverage && npm run test -- --code-coverage",
    "lint": "ng lint",
    "lint:fix": "ng lint espace-adherents --fix",
    "lint:styles": "stylelint ./src/**/*.scss",
    "lint:ci": "npm run lint && npm run lint:styles",
    "pree2e": "webdriver-manager update --standalone false --gecko false",
    "e2e": "ng e2e",
    "docs": "compodoc -p src/tsconfig.app.json -d docs",
    "docs:serve": "compodoc -p src/tsconfig.app.json -d docs -s",
    "prepush": "npm run lint:ci",
    "release:changelog": "npm run conventional-changelog -- -p angular -i CHANGELOG.md -s",
    "geneapiauth": "ng-openapi-gen --input  src/api/swagger/resource-authorization.yaml --output src/api/generated/authorization/",
    "geneapiadh": "ng-openapi-gen --input  src/api/swagger/resource-adherents.yaml --output src/api/generated/adherents/"
  },
  "dependencies": {
    "@angular/animations": "^21.2.26",
    "@angular/cdk": "~21.0.6",
    "@angular/common": "^21.2.26",
    "@angular/compiler": "^21.2.26",
    "@angular/core": "^21.2.26",
    "@angular/forms": "^21.2.26",
    "@angular/platform-browser": "^21.2.26",
    "@angular/platform-browser-dynamic": "^21.2.26",
    "@angular/router": "^21.2.26",
    "@fullcalendar/angular": "~6.1.22",
    "@fullcalendar/core": "~6.1.22",
    "@fullcalendar/daygrid": "~6.1.22",
    "@fullcalendar/interaction": "~6.1.22",
    "@fullcalendar/list": "~6.1.22",
    "@fullcalendar/timegrid": "~6.1.22",
    "@kolkov/angular-editor": "^3.4.0",
    "@nebular/auth": "17.0.0",
    "@nebular/eva-icons": "17.0.0",
    "@nebular/security": "17.0.0",
    "@nebular/theme": "17.0.0",
    "@types/ws": "^8.5.4",
    "bootstrap": "4.3.1",
    "echarts": "^5.6.0",
    "eva-icons": "^1.1.3",
    "ionicons": "2.0.1",
    "nebular-icons": "1.1.0",
    "ngx-echarts": "^21.0.0",
    "ngx-image-cropper": "^9.1.7",
    "ngx-mask": "^21.1.0",
    "normalize.css": "6.0.0",
    "pace-js": "1.0.2",
    "roboto-fontface": "0.8.0",
    "rxjs": "~7.8.2",
    "sanitize-filename": "^1.6.3",
    "socicon": "3.0.5",
    "tslib": "^2.9.1",
    "typeface-exo": "0.0.22",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.26",
    "@angular-eslint/builder": "^21.4.0",
    "@angular-eslint/eslint-plugin": "^21.4.0",
    "@angular-eslint/eslint-plugin-template": "^21.4.0",
    "@angular-eslint/schematics": "^21.4.0",
    "@angular-eslint/template-parser": "^21.4.0",
    "@angular/cli": "^21.2.26",
    "@angular/compiler-cli": "^21.2.26",
    "@angular/language-service": "^21.2.26",
    "@compodoc/compodoc": "^1.1.23",
    "@fortawesome/fontawesome-free": "^5.2.0",
    "@types/d3-color": "1.0.5",
    "@types/jasmine": "~3.3.0",
    "@types/jasminewd2": "2.0.3",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "conventional-changelog-cli": "^4.1.0",
    "eslint": "^8.28.0",
    "husky": "0.13.3",
    "jasmine-core": "~3.6.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.3.19",
    "karma-chrome-launcher": "~3.1.1",
    "karma-cli": "1.0.1",
    "karma-coverage-istanbul-reporter": "~3.0.2",
    "karma-jasmine": "~4.0.2",
    "karma-jasmine-html-reporter": "^1.7.0",
    "npm-run-all": "4.0.2",
    "protractor": "^7.0.0",
    "rimraf": "2.6.1",
    "stylelint": "^16.2.1",
    "ts-node": "3.2.2",
    "typescript": "~5.9.3"
  }
}
